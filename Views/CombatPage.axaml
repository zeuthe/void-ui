<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoidUI.Views.CombatPage">
    <Grid RowDefinitions="*,Auto">

        <!-- Content -->
        <Border Grid.Row="0" Background="Transparent">
            <Grid ColumnDefinitions="*,320">
                <!-- Server list -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBox Name="CombatFilter" Grid.Row="0" Watermark="Filter servers / players..."
                                 Background="{StaticResource SurfaceLow}" BorderBrush="{StaticResource BorderSubtle}"
                                 BorderThickness="0,0,0,1" CornerRadius="0" Padding="14,0" Height="36"
                                 Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel Name="ServersPanel" Spacing="0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- Log -->
                <ScrollViewer Grid.Column="1" Name="LogScroll">
                    <TextBlock Name="LogText" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="16,12"
                               Text="[COMBAT] Waiting for events..."/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBase}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                <!-- Run button (toggle start/stop) -->
                <Button Classes="action" Name="RunBtn" Content="Run" Grid.Column="0" Height="30" Padding="14,0"
                        ToolTip.Tip="Start/Stop monitoring" Opacity="1"/>

                <!-- Auto button -->
                <Button Classes="ghost" Name="AutoBtn" Content="Auto" Grid.Column="1" Height="30" Padding="14,0"
                        ToolTip.Tip="Auto-parse in background"/>

                <!-- Status -->
                <TextBlock Name="StatusText" Text="Idle" Foreground="{StaticResource TextTertiary}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0" Grid.Column="2"/>

                <!-- BattleMetrics -->
                <Button Classes="pill" Name="OpenBMBtn" Content="BattleMetrics" Grid.Column="3" Height="24"
                        Padding="12,0" FontSize="10" Margin="8,0,0,0"
                        ToolTip.Tip="Open server tracking site"/>

                <!-- Add custom site -->
                <Button Classes="pill" Name="AddSiteBtn" Content="+" Grid.Column="4" Height="24" Width="28"
                        Padding="0,0" FontSize="12" Margin="4,0,0,0"
                        ToolTip.Tip="Add a custom tracking site"/>

                <!-- Custom sites (with remove cross) -->
                <ScrollViewer Grid.Column="5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Height="26" Margin="6,0,0,0">
                    <StackPanel Name="CustomSitesBar" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- Clear Log -->
                <Button Classes="ghost" Name="ClearLogBtn" Content="Clear" Grid.Column="6"/>

                <!-- Export Log -->
                <Button Classes="ghost" Name="ExportLogBtn" Content="Export" Grid.Column="7"/>
            </Grid>
        </Border>
    </Grid>

    <!-- Button styles when active -->
    <UserControl.Styles>
        <Style Selector="Button#RunBtn.active">
            <Setter Property="Background" Value="#22c55e"/>
        </Style>
        <Style Selector="Button#AutoBtn.active">
            <Setter Property="Background" Value="#3b82f6"/>
        </Style>
    </UserControl.Styles>
</UserControl>
